generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Fictional prediction account on the Charoof demo ledger.
model Capper {
  id          String  @id
  handle      String  @unique
  displayName String
  focus       String
  bio         String
  hue         Int
  isDemo      Boolean @default(true)
  picks       Pick[]
}

/// Fixture. Sample rows use invented scores. The Fri Sep 18 archive uses public finals.
model Event {
  id               String   @id
  sport            String
  season           String
  weekLabel        String
  name             String
  startsAt         DateTime
  status           String
  homeName         String
  awayName         String
  homeScore        Int?
  awayScore        Int?
  homeFirstQuarter Int?
  awayFirstQuarter Int?
  homeFirstHalf    Int?
  awayFirstHalf    Int?
  source           String
  sourceNote       String
  picks            Pick[]

  @@index([sport, season])
}

/// A posted pick. Grade is derived from the event final and the posted number.
model Pick {
  id           String   @id
  capperId     String
  eventId      String
  market       String
  side         String
  line         Float?
  /// Null when the article did not post a price. Unit math then uses even money.
  oddsAmerican Int?
  units        Float
  selection    String
  /// final, 1q, or 1h. Team totals also set participant.
  scoreScope   String  @default("final")
  /// home or away when the market is that team's points. Null for game markets.
  participant  String?
  propPlayer   String?
  propStat     String?
  propActual   Float?
  publishedAt  DateTime
  clarity      String
  grade        String
  note         String?
  /// Article or post this pick was copied from. Empty on demo fiction.
  sourceUrl    String   @default("")
  isDemo       Boolean  @default(true)
  capper       Capper   @relation(fields: [capperId], references: [id], onDelete: Cascade)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([capperId])
  @@index([eventId])
}
